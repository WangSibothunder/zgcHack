# =============================================================================
# 转诊迹｜转院病历证据时间轴 — Public Demo 环境变量
# 公开仓库只保存占位符，绝不提交真实密钥。
# =============================================================================

# 是否启用外部 API。public demo 默认 false；本地合成测试时可设置 true。
# 若设为 true，下方 VIVO_APP_ID 与 VIVO_APP_KEY 必须填写有效值。
EXTERNAL_AI_ENABLED=false

# ── OCR provider ──────────────────────────────────────────────────────────────
# 可选值: mock | vivo_general_ocr | vivo
OCR_PROVIDER=mock

# vivo AI 平台通用 OCR 端点（可跟随官方文档调整）
VIVO_OCR_HOST=api-ai.vivo.com.cn
VIVO_OCR_PATH=/ocr/general_recognition
VIVO_OCR_BUSINESS_ID=
VIVO_OCR_POSITION_MODE=
VIVO_OCR_TIMEOUT_SECONDS=30

# ── LLM provider ──────────────────────────────────────────────────────────────
# 可选值: mock | vivo_bluelm | bluelm | vivo
LLM_PROVIDER=mock

# vivo BlueLM LLM 端点（可跟随官方文档调整）
VIVO_LLM_HOST=api-ai.vivo.com.cn
VIVO_LLM_PATH=/v1/chat/completions
VIVO_LLM_MODEL=BlueLM
VIVO_LLM_STREAM=false
VIVO_LLM_TIMEOUT_SECONDS=45

# ── vivo 平台通用鉴权 ───────────────────────────────────────────────────────
# APP_ID 与 APP_KEY 从 vivo AIGC 创新赛平台申请。
# 本地调试时必须填写，但 .env 文件绝不被 git 追踪。
VIVO_APP_ID=
VIVO_APP_KEY=

# ── 安全拦截 ─────────────────────────────────────────────────────────────────
# 仅允许 synthetic 合成演示数据进入外部 API
ALLOW_EXTERNAL_API_FOR_SYNTHETIC_ONLY=true
